@@ -333,10 +370,9 @@ static void fthd_pci_remove(struct pci_dev *pdev)
 
 	fthd_stop_firmware(dev_priv);
 
+	fthd_irq_quiesce(dev_priv);
 	fthd_irq_uninstall(dev_priv);
 
