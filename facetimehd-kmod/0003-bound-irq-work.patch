+/* Stop new work before waiting for the last channel dispatch to finish. */
+static void fthd_irq_quiesce(struct fthd_private *dev_priv)
+{
+	spin_lock_irq(&dev_priv->io_lock);
+	fthd_irq_disable_locked(dev_priv);
+	spin_unlock_irq(&dev_priv->io_lock);
+	cancel_work_sync(&dev_priv->irq_work);
+}
+
 static void fthd_irq_work(struct work_struct *work)
 {
 	struct fthd_private *dev_priv = container_of(work, struct fthd_private, irq_work);
-	struct fw_channel *chan;
+	u32 pending, uncleared = 0, progress = 0;
+	int i;
 
-	u32 pending;
-	int i = 0;
-
-	while(i++ < 500) {
-		spin_lock_irq(&dev_priv->io_lock);
-		pending = FTHD_ISP_REG_READ(ISP_IRQ_STATUS);
-		spin_unlock_irq(&dev_priv->io_lock);
-
-		if (!(pending & 0xf0))
-			break;
+	spin_lock_irq(&dev_priv->io_lock);
+	if (!dev_priv->irq_enabled)
+		goto unlock;
 
+	pending = FTHD_ISP_REG_READ(ISP_IRQ_STATUS);
+	if (pending & FTHD_IRQ_SOURCES) {
 		pci_write_config_dword(dev_priv->pdev, 0x94, 0);
-		spin_lock_irq(&dev_priv->io_lock);
 		FTHD_ISP_REG_WRITE(pending, ISP_IRQ_CLEAR);
-		spin_unlock_irq(&dev_priv->io_lock);
 		pci_write_config_dword(dev_priv->pdev, 0x90, 0x200);
+		/* A new event arriving during dispatch is not a failed ACK. */
+		uncleared = pending & FTHD_ISP_REG_READ(ISP_IRQ_STATUS);
+	}
+	spin_unlock_irq(&dev_priv->io_lock);
+
+	/* Sources are shared. Give every signalled or unfinished channel a turn. */
+	for (i = 0; i < dev_priv->num_channels; i++) {
+		struct fw_channel *chan = dev_priv->channels[i];
+		u32 source = BIT(4 + chan->source);
+		int count;
+
+		if (!(pending & source) && !(dev_priv->irq_backlog & BIT(i)))
+			continue;
+		count = fthd_handle_irq(dev_priv, chan);
+		if (count < 0) {
+			spin_lock_irq(&dev_priv->io_lock);
+			if (dev_priv->irq_enabled) {
+				fthd_irq_disable_locked(dev_priv);
+				dev_err(&dev_priv->pdev->dev,
+					"%s: ring service failed (%d), camera interrupts disabled\n",
+					chan->name, count);
+			}
+			goto unlock;
+		}
+		if (count)
+			progress |= source;
+		if (count == FTHD_IRQ_RING_BUDGET)
+			dev_priv->irq_backlog |= BIT(i);
+		else
+			dev_priv->irq_backlog &= ~BIT(i);
+	}
 
-		for(i = 0; i < dev_priv->num_channels; i++) {
-			chan = dev_priv->channels[i];
+	spin_lock_irq(&dev_priv->io_lock);
+	if (!dev_priv->irq_enabled)
+		goto unlock;
 
+	pending = FTHD_ISP_REG_READ(ISP_IRQ_STATUS) & FTHD_IRQ_SOURCES;
+	uncleared &= pending & ~progress;
+	for (i = 0; i < ARRAY_SIZE(dev_priv->irq_retries); i++) {
+		u32 source = BIT(4 + i);
 
-			BUG_ON(chan->source > 3);
-			if (!((0x10 << chan->source) & pending))
-				continue;
-			fthd_handle_irq(dev_priv, chan);
+		if (!(uncleared & source)) {
+			dev_priv->irq_retries[i] = 0;
+			continue;
+		}
+		if (++dev_priv->irq_retries[i] == FTHD_IRQ_RETRY_LIMIT) {
+			fthd_irq_disable_locked(dev_priv);
+			dev_err(&dev_priv->pdev->dev,
+				"IRQ source %#x stuck after %u acknowledgements, camera interrupts disabled\n",
+				source, dev_priv->irq_retries[i]);
+			goto unlock;
 		}
 	}
-
-	if (i >= 500) {
-		dev_err(&dev_priv->pdev->dev, "irq stuck, disabling\n");
-		fthd_irq_uninstall(dev_priv);
+	if (!pending && !dev_priv->irq_backlog) {
+		pci_write_config_dword(dev_priv->pdev, 0x94, 0x200);
+		/* Catch an event latched between the idle check and rearm. */
+		if (!(FTHD_ISP_REG_READ(ISP_IRQ_STATUS) & FTHD_IRQ_SOURCES))
+			goto unlock;
+		pci_write_config_dword(dev_priv->pdev, 0x94, 0);
 	}
-	pci_write_config_dword(dev_priv->pdev, 0x94, 0x200);
+	schedule_work(&dev_priv->irq_work);
+unlock:
+	spin_unlock_irq(&dev_priv->io_lock);
 }
 
 static irqreturn_t fthd_irq_handler(int irq, void *arg)
 {
 	struct fthd_private *dev_priv = arg;
-	u32 pending;
+	irqreturn_t ret = IRQ_NONE;
 	unsigned long flags;
 
 	spin_lock_irqsave(&dev_priv->io_lock, flags);
-	pending = FTHD_ISP_REG_READ(ISP_IRQ_STATUS);
+	if (dev_priv->irq_enabled &&
+	    (FTHD_ISP_REG_READ(ISP_IRQ_STATUS) & FTHD_IRQ_SOURCES)) {
+		pci_write_config_dword(dev_priv->pdev, 0x94, 0);
+		schedule_work(&dev_priv->irq_work);
+		ret = IRQ_HANDLED;
+	}
 	spin_unlock_irqrestore(&dev_priv->io_lock, flags);
-
-	if (!(pending & 0xf0))
-		return IRQ_NONE;
-
-	schedule_work(&dev_priv->irq_work);
-
-	return IRQ_HANDLED;
+	return ret;
 }
 
