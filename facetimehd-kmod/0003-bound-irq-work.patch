+#define FTHD_IRQ_RING_BUDGET 32
+#define FTHD_IRQ_RETRY_LIMIT 500
+#define FTHD_IRQ_SOURCES 0xf0
 
-static void fthd_handle_irq(struct fthd_private *dev_priv, struct fw_channel *chan)
+/* Receive can advance the ring. Only fetch an entry we will actually handle. */
+static int fthd_handle_irq(struct fthd_private *dev_priv, struct fw_channel *chan)
 {
+	int count, ret;
 	u32 entry;
-	int ret;
 
-	if (chan == dev_priv->channel_io) {
-		pr_debug("IO channel ready\n");
+	if (chan == dev_priv->channel_io || chan == dev_priv->channel_buf_h2t ||
+	    chan == dev_priv->channel_debug) {
+		pr_debug("%s channel ready\n", chan->name);
